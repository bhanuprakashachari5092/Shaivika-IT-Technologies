# SHAIVIKA IT TECHNOLOGIES — ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env for local development
# NEVER commit real credentials to Git

# Supabase PostgreSQL Configuration (Required)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Admin Dashboard API Authentication (Recommended)
ADMIN_KEY=your_admin_secret_key

# IP Anonymization Salt (Optional)
IP_SALT=your_random_salt_here

# Email Notification Delivery (Optional)
RESEND_API_KEY=
EMAIL_FROM=inquiries@shaivikaittechnologies.in
