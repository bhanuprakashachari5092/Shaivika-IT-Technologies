# SHAIVIKA IT TECHNOLOGIES — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local development
# NEVER commit real credentials or private keys to Git

# Supabase PostgreSQL Configuration (Required for Serverless Backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gmail SMTP Configuration (Lead Notification Alerts)
# IMPORTANT: SMTP_PASS must be a 16-character Gmail App Password (never your standard account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=shaivikagroups@gmail.com
SMTP_PASS=your_gmail_app_password

# Notification Target & CRM URL
LEAD_NOTIFICATION_EMAIL=shaivikagroups@gmail.com
ADMIN_DASHBOARD_URL=https://shaivikaittechnologies.in/admin

# Optional Server Settings
IP_SALT=your_random_salt_for_ip_anonymization
